<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvPermissionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMS Permission Status"
        android:textAlignment="center"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/tvLastNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No notifications sent yet."
        android:textAlignment="center"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btnAllowSMS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Allow SMS notifications" />

    <Button
        android:id="@+id/btnDenySMS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deny SMS notifications" />

    <Button
        android:id="@+id/btnBackToTracker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Tracker" />
</LinearLayout>